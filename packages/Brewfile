# The usual macOS tools, installed by os/macos.sh with `brew bundle install`.
# Command line tools come from mise instead where it can install them (mise/global.toml, and
# the configs' own mise/*.toml): Node, Python, jq, kubectl, pnpm, cargo-binstall, maven, colima,
# lazydocker, pgcli, fzf, zoxide, bat, fd, ripgrep. Without mise, install.sh and the configs'
# install.sh files get those from Homebrew. Alacritty isn't listed either: Homebrew disabled its
# cask (see os/macos.sh).

# Shell and command line
brew "bash"       # macOS ships bash 3.2
brew "bc"
brew "coreutils"  # GNU ls, date, ... (g-prefixed)
brew "gawk"
brew "gnu-sed"
brew "btop"       # not from mise: btop's own releases are Linux-only
brew "thefuck"    # not in mise's registry, and the PyPI release breaks on Python 3.12+
brew "tmux"

# Development
brew "gh"         # bootstrap.sh needs it before the dotfiles, and so mise, are there
cask "visual-studio-code"

# Containers: colima (from mise, mise/global.toml) runs the Docker engine without Docker
# Desktop; these are the CLI and its plugins
brew "docker"
brew "docker-buildx"
brew "docker-compose"
brew "docker-credential-helper"
cask "docker-desktop"

# Work
brew "postgresql@17"
cask "dbeaver-community"
cask "gcloud-cli"
cask "postman"

# LaTeX (texlab in Neovim)
cask "basictex"

# Apps
cask "spotify"
